    "/(dashboard)/products/[id]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(dashboard)/products/[id]/page.js"
    ],
    "/api/auth/refresh/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/auth/refresh/route.js"
