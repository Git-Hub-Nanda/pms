NEXT_PUBLIC_API_BASE_URL=https://dummyjson.com
# Server-only URL of the production identity provider. It must implement /login and /refresh.
AUTH_API_URL=https://identity.example.com
AUTH_COOKIE_SECURE=true

# With AUTH_API_URL unset, development mode uses local seeded users only:
# admin@pms.local / Admin#12345! (admin)
# manager@pms.local / Manager#123! (manager)
# viewer@pms.local / Viewer#12345! (viewer)
